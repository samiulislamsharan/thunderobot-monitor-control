{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thunderobot-monitor-control",
  "version": "1.0.0",
  "identifier": "com.thunderobot.monitorcontrol",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "ThundeRobot Monitor Control",
        "label": "main",
        "width": 1050,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
